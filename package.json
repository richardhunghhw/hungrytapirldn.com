{
  "private": true,
  "name": "hungrytapirldn.com",
  "license": "MIT",
  "scripts": {
    "postinstall": "remix-esbuild-override",
    "build": "concurrently \"npm run build:*\"",
    "build:remix": "remix build --sourcemap",
    "build:css": "tailwindcss -m -i ./app/styles/tailwind.css -o app/styles/app.css",
    "dev": "concurrently \"npm run dev:*\"",
    "dev:css": "tailwindcss -w -i ./app/styles/tailwind.css -o app/styles/app.css",
    "dev:remix": "remix watch",
    "dev:wrangler": "wrangler pages dev ./public --compatibility-date 2023-06-15 --live-reload true",
    "typecheck": "tsc",
    "test": "jest",
    "logs:test": "wrangler pages deployment tail --project-name hungrytapir-store --environment preview",
    "logs:prod": "wrangler pages deployment tail --project-name hungrytapir-store --environment production"
  },
  "eslintIgnore": [
    "/node_modules",
    "/server/build",
    "/public/build"
  ],
  "dependencies": {
    "@notionhq/client": "^2.2.8",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-navigation-menu": "^1.1.3",
    "@radix-ui/react-select": "^1.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@remix-run/cloudflare": "^2.17.4",
    "@remix-run/cloudflare-pages": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@sentry/remix": "^8.55.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "dompurify": "^3.0.5",
    "imagekit": "^5.2.0",
    "imagekitio-react": "^3.0.0",
    "is-ip": "^5.0.1",
    "isbot": "^4.4.0",
    "lucide-react": "^0.499.0",
    "markdown-to-jsx": "^7.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-utils": "^7.7.0",
    "stripe": "^14.25.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260402.1",
    "@jest/globals": "^29.7.0",
    "@remix-run/dev": "^2.17.4",
    "@remix-run/eslint-config": "^2.17.4",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.0.1",
    "dotenv": "^16.1.4",
    "esbuild-plugin-replace": "^1.4.0",
    "eslint": "^8.38.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.22",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "remix-esbuild-override": "^3.1.0",
    "stripe-event-types": "^3.1.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.6",
    "typescript": "^5.9.3",
    "vitest": "^0.32.0",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
